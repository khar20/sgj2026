[node name="Intro" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_ioskq")
lore_entries = Array[String](["El Sector A3 permanece bajo condiciones extremas de conflicto y aislamiento. La infraestructura civil se encuentra gravemente comprometida y la presencia de fuerzas capaces de mantener el orden es cada vez más limitada. La situación ha alcanzado un punto crítico, dejando a las poblaciones del sector en una dependencia cada vez mayor de las fuerzas que aún tienen capacidad para operar en la zona.", "El Protocolo Blackstone fue diseñado como la única estrategia de supervivencia para la especie humana. Su existencia responde a una situación en la que las medidas convencionales han dejado de ser suficientes para garantizar la continuidad de la humanidad. Blackstone no representa una alternativa entre muchas, sino el último recurso disponible.", "La Unidad Puma fue creada con el único objetivo de realizar operaciones militares en la Distorsión. Debido al deterioro de la situación en el Sector A3 y al colapso progresivo de las fuerzas destinadas a contenerla, Puma se ha convertido en una de las pocas unidades con capacidad real para operar en el sector. Su experiencia y conocimiento del territorio han llevado a que sus funciones se extiendan también a labores de ayuda civil, proporcionando protección, suministros y soporte a las poblaciones que permanecen allí. Para muchos de ellos, Puma es actualmente la única fuerza capaz de ofrecer asistencia.", "«Tenemos deberes que cumplir. Mientras quede un solo cartucho, seguiremos cumpliéndolos. No por gloria, sino porque la supervivencia de la humanidad depende de ello.»
-- Comandante Elias Varek, Unidad Puma"])
game_scene = ExtResource("2_yjqpq")

